# 복사해서 .env 로 저장 (.env는 git에서 제외됨)
LLM_BASE_URL=https://example.com/llm/v1
DEFAULT_LLM_MODEL=model-name
LLM_API_KEY=sk-xxxx
# (선택) Semantic Scholar API 키 — 없어도 동작하지만 요청 제한이 더 엄격함
S2_API_KEY=
# (선택) alphaXiv API 키 — 설정 시 daily.py에서 alphaXiv 논문도 함께 수집
ALPHAXIV_API_KEY=

# 섭노트 데이터 DB (PostgreSQL) — daily.py의 기법 사전·카드·데일리·즐겨찾기 원본
SUPNOTE_DB_HOST=localhost
SUPNOTE_DB_PORT=5432
SUPNOTE_DB_NAME=
SUPNOTE_DB_USER=
SUPNOTE_DB_PASSWORD=
SUPNOTE_DB_SCHEMA=supnote
